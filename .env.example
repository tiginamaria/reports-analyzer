# Copy to .env in the repo root. Docker compose and a backend run on the host both read it.

# Which LLM to use: anthropic | openai
LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=
# Only for user-scoped keys (sk-ant-usr-...): the workspace id from the Anthropic console
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_SMALL_MODEL=claude-haiku-4-5-20251001

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_SMALL_MODEL=gpt-5-mini

# Local models (downloaded on first use, cached in a docker volume)
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Only needed outside docker compose
DATABASE_URL=postgresql+psycopg://reports:reports@localhost:5432/reports
REPORTS_DIR=../data/store
