# Copy to .env in the repo root. Docker compose and a backend run on the host both read it.

# Which LLM answers, extracts and detects metadata: openai (default) | anthropic.
# With openai one key covers the LLM and the hosted embeddings below.
LLM_PROVIDER=openai

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
OPENAI_SMALL_MODEL=gpt-5-mini
# Reasoning effort of the gpt-5 family: minimal | low | medium | high (low: grounded answers
# over given passages need little thinking; higher is slower and eats the output budget)
OPENAI_REASONING_EFFORT=low

ANTHROPIC_API_KEY=
# Only for user-scoped keys (sk-ant-usr-...): the workspace id from the Anthropic console
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_SMALL_MODEL=claude-haiku-4-5-20251001

# Retrieval stack, independent of the LLM provider, one switch:
#   openai  hosted text-embedding-3-large embeddings, no reranker (default; needs OPENAI_API_KEY)
#   local   bge-m3 embeddings and the bge-reranker-v2-m3 cross-encoder in-process
#           (the `local-models` dependency group; in Docker build with --build-arg LOCAL_MODELS=1)
# Reports are searched only when embedded with the configured model: after switching, run
# `python -m app.reembed` or delete and upload them again.
RETRIEVAL_MODELS=openai

# Optional overrides of what the switch sets (leave empty to follow RETRIEVAL_MODELS)
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
RERANKER_PROVIDER=
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# Hosted embeddings: key (falls back to OPENAI_API_KEY), any OpenAI-compatible server,
# texts per request, requests in flight, seconds per request, retries per request
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_BATCH_SIZE=64
EMBEDDING_CONCURRENCY=4
EMBEDDING_TIMEOUT_SECONDS=60
EMBEDDING_MAX_RETRIES=3

# Only needed outside docker compose
DATABASE_URL=postgresql+psycopg://reports:reports@localhost:5432/reports
REPORTS_DIR=../data/store
